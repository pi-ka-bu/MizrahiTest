{
  "openapi": "3.0.1",
  "info": {
    "title": "TestAPI",
    "description": "API for performing simple arithmetic operations (ASP.NET Core 8.0)",
    "contact": {
      "name": "Calculator API"
    },
    "version": "v1"
  },
  "paths": {
    "/api/auth/token": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/TestAPI.Controllers.TokenRequest"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TestAPI.Controllers.TokenRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/TestAPI.Controllers.TokenRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/TestAPI.Controllers.TokenRequest"
              }
            },
            "application/xml": {
              "schema": {
                "$ref": "#/components/schemas/TestAPI.Controllers.TokenRequest"
              }
            },
            "text/xml": {
              "schema": {
                "$ref": "#/components/schemas/TestAPI.Controllers.TokenRequest"
              }
            },
            "application/*+xml": {
              "schema": {
                "$ref": "#/components/schemas/TestAPI.Controllers.TokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/math": {
      "post": {
        "tags": [
          "Calculation"
        ],
        "parameters": [
          {
            "name": "X-ArithmeticOp-ID",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/TestAPI.Models.MathRequest"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TestAPI.Models.MathRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/TestAPI.Models.MathRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/TestAPI.Models.MathRequest"
              }
            },
            "application/xml": {
              "schema": {
                "$ref": "#/components/schemas/TestAPI.Models.MathRequest"
              }
            },
            "text/xml": {
              "schema": {
                "$ref": "#/components/schemas/TestAPI.Models.MathRequest"
              }
            },
            "application/*+xml": {
              "schema": {
                "$ref": "#/components/schemas/TestAPI.Models.MathRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TestAPI.Controllers.TokenRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "TestAPI.Models.MathRequest": {
        "required": [
          "operation",
          "x",
          "y"
        ],
        "type": "object",
        "properties": {
          "operation": {
            "$ref": "#/components/schemas/TestAPI.Models.MathRequest.OperationEnum"
          },
          "x": {
            "type": "number",
            "format": "double"
          },
          "y": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "TestAPI.Models.MathRequest.OperationEnum": {
        "enum": [
          0,
          1,
          2,
          3
        ],
        "type": "integer",
        "format": "int32"
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "apiKey",
        "description": "JWT Authorization header using the Bearer scheme. Enter 'Bearer' [space] and then your token.",
        "name": "Authorization",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}