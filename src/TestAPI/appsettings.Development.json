{
  "Logging": {
    "IncludeScopes": false,
    "LogLevel": {
      "Default": "Debug",
      "System": "Information",
      "Microsoft": "Information",
      "TestAPI": "Debug"
    }
  },
  "Cache": {
    "Type": "Memory",
    "DurationSeconds": 30
  },
  "Kafka": {
    "Enabled": false,
    "BootstrapServers": "localhost:9092",
    "Topic": "math-operations"
  },
  "ExternalApi": {
    "MockoonBaseUrl": "http://localhost:3000",
    "TimeoutSeconds": 30,
    "UseFallback": true
  }
}
