{
  "Logging": {
    "IncludeScopes": false,
    "LogLevel": {
      "Default": "Information",
      "System": "Information",
      "Microsoft": "Information"
    }
  },
  "Urls": "http://localhost:5000;https://localhost:5001",
  "Jwt": {
    "SecretKey": "this-is-a-very-long-secret-key-for-jwt-token-generation-at-least-256-bits",
    "Issuer": "TestAPI",
    "Audience": "TestAPIClients",
    "ExpirationMinutes": 60
  },
  "Cache": {
    "Type": "Redis",
    "DurationSeconds": 30,
    "RedisConnectionString": "localhost:6379"
  },
  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "localhost:9092",
    "Topic": "math-operations"
  },
  "ExternalApi": {
    "MockoonBaseUrl": "http://localhost:3000",
    "TimeoutSeconds": 30,
    "UseFallback": true
  }
}
